---
import { render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { allDocs, blurbs } from "../../lib/docs";

export async function getStaticPaths() {
  const docs = await allDocs();
  return docs.map((doc, i) => ({ params: { slug: doc.slug }, props: { doc, prev: docs[i - 1], next: docs[i + 1] } }));
}

const { doc, prev, next } = Astro.props;
const { Content, headings } = await render(doc.entry);
---

<DocsLayout
  title={`${doc.title} · hamstack docs`}
  description={blurbs[doc.slug] ?? `${doc.title}: part of the hamstack documentation.`}
  current={doc.slug}
  headings={headings}
  prev={prev}
  next={next}
>
  <Content />
</DocsLayout>
